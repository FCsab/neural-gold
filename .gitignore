# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data and state (regenerated, never committed). Root-anchored: a bare
# 'data/' would also swallow the crypto_neural/data package.
/data/
*.parquet
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.pt
*.ckpt
logs/
checkpoints/

# Secrets and TLS material
.env
.env.*
*.pem
*.key
/.token
/certs/
!.gitignore

# Editor / OS
.vscode/
.idea/
.DS_Store

# Tooling scratch
.deepseek/
